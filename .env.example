# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env

# Clave de la API de WAHA. Generá una al azar, por ejemplo con:
#   openssl rand -hex 24
WAHA_API_KEY=

# URL donde escucha WAHA. Dejala así si corre en la misma máquina.
WAHA_URL=http://localhost:3000

# Motor de conexión:
#   NOWEB  -> WebSocket, liviano, recomendado (poca RAM, arranca rápido)
#   WEBJS  -> Chromium headless, más pesado, útil si NOWEB falla
WAHA_ENGINE=NOWEB

# Nombre de la sesión que se usa cuando no aclarás cuál.
# Cada número vinculado es una sesión con su propio nombre.
WA_SESION_DEFAULT=principal

# Carpeta donde el MCP guarda su contador de envíos.
WA_DATA_DIR=./datos

TZ=America/Argentina/Buenos_Aires

# ---------------------------------------------------------------------------
# Límites de envío. Están para que el número no se queme.
# El MCP los aplica siempre y no se pueden saltear desde el chat:
# para cambiarlos hay que editar este archivo y reiniciar.
# ---------------------------------------------------------------------------

# Techo de mensajes por hora y por día (todos los destinatarios).
LIMITE_POR_HORA=20
LIMITE_POR_DIA=100

# Techo diario aparte para números a los que nunca les escribiste.
# Este es el que más pesa en una detección: mensajes a desconocidos.
LIMITE_NUEVOS_POR_DIA=20

# Espera aleatoria antes de cada envío, en milisegundos.
# El rango random es a propósito: un intervalo fijo es una firma de bot.
RETARDO_MIN_MS=8000
RETARDO_MAX_MS=25000
